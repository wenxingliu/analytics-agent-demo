# Set at least one provider key. The sidebar lets you pick provider and model; *_MODEL is the default.
MOONSHOT_API_KEY=sk-...
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1   # https://api.moonshot.cn/v1 for the China region
KIMI_MODEL=                                     # check the Moonshot docs for current model ids

OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=                                   # e.g. a current OpenAI chat model id

# LLM_PROVIDER=kimi                             # kimi or openai: which one is selected first

# SEMANTIC_LAYER_PATH=./semantic_layer
# DATABASE_URL=sqlite:///data/demo.db
# MAX_ROWS=1000
# QUERY_TIMEOUT_SECONDS=30
# MAX_AGENT_STEPS=5
# ALLOW_PII=true                                # false hides pii columns from the model
