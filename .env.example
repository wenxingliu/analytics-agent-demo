# Set at least one provider key. The sidebar lets you pick provider and model; *_MODEL is the default.
MOONSHOT_API_KEY=sk-...
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1   # https://api.moonshot.cn/v1 for the China region
KIMI_MODEL=kimi-k3.1-pro-highspeed              # default if empty; check the Moonshot docs for current model ids

OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=                                   # e.g. a current OpenAI chat model id

# LLM_PROVIDER=kimi                             # kimi or openai: which one is selected first

# Guardrails: limit what the agent can pull. Both true/false flags default to true when unset.
# To return personal data (names, addresses, ...), set BOTH GUARDRAIL_NO_PII and
# GUARDRAIL_NO_INDIVIDUAL_DATA to false: personal-data columns identify a person, so the
# individual-data guardrail blocks them on its own.
GUARDRAIL_MIN_DATE=2026-01-01          # earliest date the agent can see (YYYY-MM-DD); empty = no limit
GUARDRAIL_NO_INDIVIDUAL_DATA=true      # true: aggregates only, no per-person rows, ids or lookups; false: row-level data allowed
GUARDRAIL_NO_PII=true                  # true: columns marked pii: true are hidden and blocked; false: shown, tagged PII

# SEMANTIC_LAYER_PATH=./semantic_layer
# DATABASE_URL=sqlite:///data/demo.db
# MAX_ROWS=1000
# QUERY_TIMEOUT_SECONDS=30
# MAX_AGENT_STEPS=5
